# Copy to .env and fill in. .env is gitignored (added in phase 0 — plain
# `.env` was committable before that).

# ---- Required -------------------------------------------------------------

GEMINI_API_KEY=

# Model IDs are required with no defaults, on purpose. Gemini model names
# change faster than this repo will be maintained, and a stale default baked
# into source is worse than an explicit failure — the run would silently use a
# model nobody chose. Run `npm run doctor` to list what your key can actually
# reach and to verify each ID below exists.
#
# The values below were confirmed against models.list() on 2026-08-08 (58 models
# visible). Re-run doctor if anything starts failing; preview IDs in particular
# get retired.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# ---- Embedding descriptor -------------------------------------------------
# These three values form the embedding cache key together with the text hash.
# Changing any of them invalidates cached vectors, which is correct: comparing
# vectors across embedding spaces silently disables duplicate detection.
# 1536 dims confirmed working against gemini-embedding-2-preview.

GEMINI_EMBEDDING_TASK_TYPE=SEMANTIC_SIMILARITY
GEMINI_EMBEDDING_DIM=1536

# ---- Site -----------------------------------------------------------------

SITE_URL=https://akashsamui.in
POST_AUTHOR=default
POST_LAYOUT=PostLayout

# ---- Dedup thresholds -----------------------------------------------------
# Provisional. Run `npm run start -- calibrate` to print the pairwise cosine
# matrix over the real corpus and set these from observed values — absolute
# Gemini cosines run high, so an uncalibrated escalation floor sends nearly
# every candidate to the LLM judge.

DEDUP_REJECT_COSINE=0.86
DEDUP_ESCALATE_COSINE=0.78
DEDUP_JACCARD=0.6

# ---- Article shape --------------------------------------------------------

TARGET_WORDS_MIN=1400
TARGET_WORDS_MAX=2200

# ---- Cadence --------------------------------------------------------------
# MAX_OPEN_BOT_PRS=1 is load-bearing: the daily cap limits PR *creation*, not
# publication. Without it, a merged backlog puts several back-dated posts live
# at once — the burst pattern the daily cap exists to prevent.

MIN_HOURS_BETWEEN_POSTS=20
MAX_OPEN_BOT_PRS=1

# ---- Reliability ----------------------------------------------------------

RETRY_ATTEMPTS=5
RETRY_BASE_MS=1000
RETRY_CAP_MS=60000
TEXT_TIMEOUT_MS=120000
RUN_CEILING_MS=1200000

# ---- Link policy ----------------------------------------------------------
# Grounded search reads arbitrary pages, so outbound links are capped and
# filtered rather than trusted.

MAX_EXTERNAL_LINKS=8
EXTERNAL_LINK_DENYLIST=

# ---- Logging --------------------------------------------------------------

LOG_LEVEL=info
LOG_FORMAT=pretty

# ---- Git / GitHub ---------------------------------------------------------
# GITHUB_TOKEN is supplied automatically in Actions. Locally, only needed for
# the publish step. Note: `gh pr create` with the default GITHUB_TOKEN returns
# 403 unless Settings -> Actions -> "Allow GitHub Actions to create and approve
# pull requests" is enabled.

GITHUB_TOKEN=
GITHUB_REPOSITORY=
STATE_BRANCH=blog-agent-state
BRANCH_PREFIX=bot/post-

# ---- Local development ----------------------------------------------------

DRY_RUN=false
OFFLINE=false
